# Copy to .env to override defaults. Every value is optional.
# Docker Compose reads this file for variable substitution; the backend also reads it
# when run natively (from the backend/ directory, copy it to backend/.env).

# --- Host ports (change if something else already uses them) ---
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Image build ---
# Only change if pypi.org is blocked on your network (use a mirror you trust).
# PIP_INDEX_URL=https://pypi.org/simple

# --- Backend ---
LOG_LEVEL=INFO
